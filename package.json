{
  "name": "lol-analyzer-desktop",
  "private": true,
  "version": "1.2.0",
  "description": "Coach en tiempo real, overlay e importación de runas para League of Legends.",
  "author": "Juan Camilo Martinez",
  "type": "module",
  "main": "dist-electron/main.js",
  "config": {
    "cloudApiUrl": "https://lolanalyzer-api.vercel.app"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "package:opk": "npm run build && node scripts/package-opk.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev:electron": "npm run build:electron && concurrently -k -n vite,electron \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build:desktop": "tsc -b && vite build --mode desktop && npm run build:electron",
    "dist:win": "npm run build:desktop && electron-builder --config electron-builder.config.cjs --win",
    "build:web": "vite build --config vite.web.config.ts"
  },
  "dependencies": {
    "koffi": "^3.3.7",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@overwolf/types": "^3.51.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.5.1"
  }
}
