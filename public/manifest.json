{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "LolAnalyzer",
    "version": "1.0.0",
    "minimum-overwolf-version": "0.230.0",
    "author": "Juan Camilo Martinez",
    "description": "Real-time League of Legends Tilt Coach, Champion Pool Assistant and Performance Telemetry Analyzer.",
    "icon": "favicon.svg",
    "icon_gray": "favicon.svg"
  },
  "permissions": [
    "GameInfo",
    "Hotkeys",
    "FileSystem"
  ],
  "data": {
    "start_window": "background",
    "windows": {
      "background": {
        "file": "background.html",
        "is_background_page": true
      },
      "desktop": {
        "file": "index.html",
        "desktop_only": false,
        "native_window": false,
        "resizable": true,
        "transparent": false,
        "size": {
          "width": 1280,
          "height": 820
        },
        "min_size": {
          "width": 1024,
          "height": 720
        },
        "max_size": {
          "width": 2560,
          "height": 1440
        }
      },
      "in_game_overlay": {
        "file": "overlay.html",
        "transparent": true,
        "resizable": false,
        "show_in_taskbar": false,
        "in_game_only": true,
        "focus_game_takeover": "ReleaseOnLostFocus",
        "size": {
          "width": 380,
          "height": 520
        },
        "start_position": {
          "top": 120,
          "left": 20
        }
      }
    },
    "hotkeys": {
      "toggle_overlay": {
        "title": "Toggle In-Game Tilt Overlay",
        "action-type": "toggle",
        "default": "Ctrl+Tab"
      },
      "toggle_compact_mode": {
        "title": "Toggle Mini-HUD Mode",
        "action-type": "custom",
        "default": "Shift+F1"
      }
    },
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [5426]
    },
    "game_events": [5426],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": {
          "game_ids": [5426]
        },
        "start_minimized": false
      }
    ]
  }
}
